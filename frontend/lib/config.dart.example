//
// The 'config.dart' file is ignored by Git to keep your choice of environment private.

class AppConfig {
  // --- For PRODUCTION (when testing the live Fly.io app) ---
  // Replace with your actual Fly.io URL
  // static const String baseUrl = 'https://your-app-name.fly.dev';

  // --- For LOCAL DEVELOPMENT (when running the backend on your machine) ---
  // For the Android Emulator, this should be 'http://10.0.2.2:8000'
  // For the iOS Simulator, this would be 'http://localhost:8000'
  static const String baseUrl = 'http://10.0.2.2:8000';
}